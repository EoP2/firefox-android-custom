+/**
+ * Returns the container color used by tab list items. Like the selected tabs, the current tab is highlighted with its
+ * background instead of an outline, except in multi-select mode where only the selected tabs are highlighted.
+ */
+@Composable
+fun tabListItemContainerColor(selectionState: TabsTrayItemSelectionState): Color {
+    val isCurrentTab = selectionState.isFocused && selectionState.focusEnabled && !selectionState.multiSelectEnabled
+
+    return if (selectionState.isSelected || isCurrentTab) {
+        MaterialTheme.colorScheme.primaryContainer
+    } else {
+        MaterialTheme.colorScheme.surface
+    }
+}
