+    private fun calculateSheetHeight(): Int {
+        val displayMetrics = resources.displayMetrics
+        val screenHeight = displayMetrics.heightPixels
+        val bottomSheet = dialog?.findViewById<View?>(materialR.id.design_bottom_sheet)
+        val statusBarHeight = bottomSheet?.getWindowInsets()?.top() ?: 0
+
+        if (requireContext().isLandscape()) {
+            return screenHeight - statusBarHeight
+        }
+
+        val maxSheetHeight = screenHeight - maxOf(SHEET_MAX_TOP_OFFSET_DP.dpToPx(displayMetrics), statusBarHeight)
+        val keylineSheetHeight = screenHeight - (displayMetrics.widthPixels * SHEET_KEYLINE_RATIO).toInt()
+
+        return minOf(keylineSheetHeight, maxSheetHeight)
+    }
