+    override fun onCreateDialog(savedInstanceState: Bundle?): Dialog =
+        BottomSheetDialog(requireContext(), theme).apply {
+            setOnShowListener {
+                val bottomSheet = findViewById<View?>(materialR.id.design_bottom_sheet)
+                bottomSheet?.setBackgroundResource(R.drawable.bottom_sheet_with_top_rounded_corners)
+
+                bottomSheetBehavior =
+                    bottomSheet?.let {
+                        BottomSheetBehavior.from(it).apply {
+                            peekHeight = resources.displayMetrics.heightPixels
+                            maxHeight = calculateSheetHeight()
+                            skipCollapsed = true
+                            state = BottomSheetBehavior.STATE_EXPANDED
+                            hideFriction = SHEET_HIDING_FRICTION
+                        }
+                    }
+
+                // Setting the max height doesn't measure the sheet again by itself.
+                bottomSheet?.requestLayout()
+            }
+        }
+
+    override fun onConfigurationChanged(newConfig: Configuration) {
+        super.onConfigurationChanged(newConfig)
+        bottomSheetBehavior?.maxHeight = calculateSheetHeight()
+        dialog?.findViewById<View?>(materialR.id.design_bottom_sheet)?.requestLayout()
+    }
+
+    /**
+     * Mimics the height of the old bottom sheet tabs tray: with only a few tabs it opened collapsed, leaving the
+     * area above the 16:9 keyline of the screen visible, otherwise it opened (almost) fully expanded.
+     */
+    private fun calculateSheetHeight(): Int {
+        val displayMetrics = resources.displayMetrics
+        val screenHeight = displayMetrics.heightPixels
+        val bottomSheet = dialog?.findViewById<View?>(materialR.id.design_bottom_sheet)
+        val statusBarHeight = bottomSheet?.getWindowInsets()?.top() ?: 0
+
+        val expandedHeight =
+            if (requireContext().isLandscape()) {
+                screenHeight - statusBarHeight
+            } else {
+                screenHeight - maxOf(SHEET_EXPANDED_TOP_OFFSET_DP.dpToPx(displayMetrics), statusBarHeight)
+            }
+        val collapsedHeight = screenHeight - (displayMetrics.widthPixels * SHEET_KEYLINE_RATIO).toInt()
+
+        return if (shouldOpenExpanded()) expandedHeight else minOf(collapsedHeight, expandedHeight)
+    }
+
+    private fun shouldOpenExpanded(): Boolean {
+        val browserState = requireComponents.core.store.state
+        val numberOfTabs = maxOf(browserState.normalTabs.size, browserState.privateTabs.size)
+        val numberForExpandingTray =
+            if (requireComponents.settings.gridTabView) EXPAND_AT_GRID_SIZE else EXPAND_AT_LIST_SIZE
+
+        return requireContext().isLandscape() || numberOfTabs >= numberForExpandingTray
+    }
