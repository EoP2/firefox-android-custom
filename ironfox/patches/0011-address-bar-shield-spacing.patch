+/**
+ * Makes this layout [trimDp] narrower on both the start and the end side. The content is still measured at its normal
+ * size and stays centered, it just overflows the layout bounds symmetrically.
+ */
+private fun Modifier.trimHorizontalSpace(trimDp: Int) = layout { measurable, constraints ->
+    val trim = trimDp.dp.roundToPx()
+    val placeable = measurable.measure(constraints)
+
+    layout((placeable.width - trim * 2).coerceAtLeast(0), placeable.height) {
+        placeable.place(-trim, 0)
+    }
+}
