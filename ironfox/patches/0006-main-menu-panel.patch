+
+package org.mozilla.fenix.components.menu
+
+import android.view.View
+import com.google.android.material.bottomsheet.BottomSheetBehavior
+import org.mozilla.fenix.utils.Settings
+
+/**
+ * Whether the menu sheet hangs from the top of the screen, instead of sitting on the bottom of it.
+ *
+ * The menu goes next to the toolbar, where the button that opens it is: at the top if the toolbar is at the top, at the
+ * bottom if the toolbar is at the bottom. With the expanded toolbar that button is in the navigation bar at the bottom
+ * of the screen, so the menu is at the bottom as well, except in a custom tab, whose menu only looks at the position
+ * of the toolbar. This is the same condition that puts the navigation buttons at the top or at the bottom of the menu.
+ *
+ * @param accessPoint Where the menu was opened from.
+ */
+internal fun Settings.isMenuAtTop(accessPoint: MenuAccessPoint): Boolean =
+    !shouldUseBottomToolbar && (accessPoint == MenuAccessPoint.External || !shouldUseExpandedToolbar)
+
+/**
+ * Makes the sheet hang from the top of the screen.
+ *
+ * A sheet that fits its contents rests on the bottom of the screen. Without that, it is expanded at the expanded
+ * offset from the top. There is nowhere to drag it to from there, so it can't be dragged.
+ *
+ * This is best done before the dialog is shown, otherwise the sheet could be on the bottom for a moment.
+ */
+internal fun BottomSheetBehavior<View>.hangFromTop() {
+    isFitToContents = false
+    expandedOffset = 0
+    isDraggable = false
+    state = BottomSheetBehavior.STATE_EXPANDED
+}
